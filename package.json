{
  "name": "@local/dsh-git-graph",
  "version": "1.0.0",
  "description": "Git changes, AI Conventional Commits, and a commit graph in the DSH right sidebar",
  "private": true,
  "type": "module",
  "exports": { ".": "./index.js", "./client": "./client.js", "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg" },
  "files": ["index.js", "git.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md"],
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" }, "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-sidebar-right", "@deepseek-ai/dsh-api-session-controller", "@deepseek-ai/dsh-api-remotes"] } },
  "scripts": { "test": "node --test test/*.test.js" }
}
